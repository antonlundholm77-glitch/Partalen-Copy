# Part Plattform — environment
# Kopiera till .env.local och fyll i värdena. .env.local är gitignored.

# --- Supabase (publika, säkra att exponera) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Endast server-side. ALDRIG NEXT_PUBLIC_*. (rls:proof m.m.) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Supabase CLI (migrations) ---
SUPABASE_PROJECT_REF=<project-ref>

# --- Microsoft Entra ID (Azure) ---
# LÄSES INTE av appen — matas in i Supabase Dashboard → Auth → Providers → Azure.
# Auth konfigureras under Part Groups Azure-klientorganisation.
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<client-secret>
AZURE_TENANT_ID=<tenant-id>
